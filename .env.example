# Optional — set ONE of these to enable AI attacker profiling in
# `honeygrid report`. Without any of them, reports are generated
# normally, just without the AI section.
# If more than one is set, priority is: ANTHROPIC_API_KEY > GEMINI_API_KEY > OPENAI_API_KEY.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional — override the default session log path used by SessionStore()
# when no --log path is passed explicitly. The CLI's --log flag always
# takes precedence over this.
HONEYGRID_LOG=honeygrid_sessions.json
