# Optional — enables Gemini attacker profiling in `honeygrid report`.
# Without it, reports are generated normally, just without the AI section.
GEMINI_API_KEY=

# Optional — override the default session log path used by SessionStore()
# when no --log path is passed explicitly. The CLI's --log flag always
# takes precedence over this.
HONEYGRID_LOG=honeygrid_sessions.json
